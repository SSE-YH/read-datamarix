# Barcode Reader deployment settings

# Job metadata, uploaded images, per-job logs, and generated CSV files live here.
# The API and cleanup script both read this value.
BARCODE_READER_STORAGE_DIR=storage/jobs

# Terminal jobs older than this many days are eligible for cleanup by
# scripts/cleanup_uploads.py. The API does not delete files by itself.
BARCODE_READER_RETENTION_DAYS=7

# Example uvicorn values for deployment scripts or process managers.
BARCODE_READER_HOST=0.0.0.0
BARCODE_READER_PORT=8000
